{
  "name": "ctxquilt",
  "version": "0.1.0",
  "description": "Pack compact, reproducible repository context bundles for coding agents.",
  "type": "module",
  "homepage": "https://github.com/rogerchappel/ctxquilt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/ctxquilt.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/ctxquilt/issues"
  },
  "bin": {
    "ctxquilt": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js pack --include README.md --budget 2000 --output /tmp/ctxquilt-smoke.md && node dist/src/cli.js explain /tmp/ctxquilt-smoke.md",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "context",
    "cli",
    "llm",
    "repository"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
