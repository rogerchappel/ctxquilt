{
  "name": "ctxquilt",
  "commands": {
    "packMarkdown": "ctxquilt pack --include \"src/**/*.ts\" --include README.md --budget 12000 --output context.md",
    "packJson": "ctxquilt pack --config ctxquilt.json --format json --output context.json",
    "explain": "ctxquilt explain context.md"
  },
  "outputs": [
    "markdown",
    "json"
  ],
  "manifest": {
    "stableGeneratedAt": "1970-01-01T00:00:00.000Z",
    "tracksIncludedFiles": true,
    "tracksOmittedFiles": true,
    "tracksRedactions": true
  }
}
